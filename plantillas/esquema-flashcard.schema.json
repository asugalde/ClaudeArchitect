{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CCAR-F flashcard deck",
  "description": "Source of truth for a block's flashcard deck. The HTML is regenerated from this JSON; never edit cards in the HTML.",
  "type": "object",
  "required": ["config", "cartas"],
  "additionalProperties": false,
  "properties": {
    "config": {
      "type": "object",
      "required": ["bloque", "nombre", "version", "fecha", "guiaOficialExamen", "generadoDesdeCorpus"],
      "additionalProperties": false,
      "properties": {
        "bloque": { "type": "integer", "minimum": 0, "maximum": 5 },
        "nombre": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "fecha": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "guiaOficialExamen": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "generadoDesdeCorpus": { "type": "string", "description": "corpus file + version, e.g. 'bloque-0-fundamentos.md v1.0'" }
      }
    },
    "cartas": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "taskStatement", "front", "back", "refSeccion", "dificultad", "etiquetas"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^b[0-5]-fc[0-9]{2}$", "description": "unique, e.g. b0-fc01" },
          "taskStatement": { "type": "string", "minLength": 3, "description": "official TS it supports (e.g. '1.1') or block axis (e.g. '0.4')" },
          "front": { "type": "string", "minLength": 10, "description": "English. A single unambiguous question or cue" },
          "back": { "type": "string", "minLength": 10, "description": "English. Self-contained answer, 1-4 sentences; may use `inline code`" },
          "refSeccion": { "type": "string", "pattern": "^#[a-z0-9-]+$", "description": "anchor existing in the block's corpus file, e.g. #ts-0-4" },
          "dificultad": { "enum": ["facil", "media", "dificil"] },
          "etiquetas": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
        }
      }
    }
  }
}
