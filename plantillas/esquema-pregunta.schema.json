{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ccar-f-question-bank.schema.json",
  "title": "CCAR-F practice question bank",
  "type": "object",
  "required": ["config", "preguntas"],
  "additionalProperties": false,
  "properties": {
    "config": {
      "type": "object",
      "required": ["titulo", "version"],
      "additionalProperties": false,
      "properties": {
        "titulo": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "bloque": { "type": ["integer", "string"], "description": "0-5 o 'simulacro'" },
        "modo_defecto": { "type": "string", "enum": ["estudio", "examen"], "default": "estudio" },
        "solo_examen": { "type": "boolean", "default": false },
        "duracion_examen_min": { "type": "integer", "minimum": 5, "maximum": 240 },
        "generado_desde_referencia": { "type": ["string", "null"], "description": "LEGADO (pipeline v1.2); usar generado_desde_corpus" },
        "generado_desde_corpus": { "type": ["string", "null"], "description": "Fichero de corpus + version, p.ej. 'bloque-0-fundamentos.md v1.0'" },
        "fecha": { "type": "string" }
      }
    },
    "preguntas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "bloque", "dominio", "taskStatement", "enunciado", "opciones", "seleccionar", "dificultad", "refSeccion"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(b[0-5]|sim)-q[0-9]{2,3}$" },
          "bloque": { "type": "integer", "minimum": 0, "maximum": 5 },
          "dominio": {
            "type": ["string", "null"],
            "description": "Nombre oficial del dominio del blueprint; null para bloque 0 (transversal)"
          },
          "taskStatement": { "type": "string", "description": "P.ej. '1.4' o '0.fundamentos'" },
          "escenario": { "type": ["string", "null"], "description": "Contexto de producción (inglés), 2-4 frases; null si la pregunta es autocontenida" },
          "enunciado": { "type": "string", "minLength": 20, "description": "La pregunta, en inglés. En multiple-response incluye 'Select TWO/THREE'" },
          "opciones": {
            "type": "array",
            "minItems": 4,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["id", "texto", "correcta", "justificacion"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[A-E]$" },
                "texto": { "type": "string", "minLength": 5 },
                "correcta": { "type": "boolean" },
                "justificacion": { "type": "string", "minLength": 15, "description": "Por qué es correcta o por qué falla (inglés)" }
              }
            }
          },
          "seleccionar": { "type": "integer", "minimum": 1, "maximum": 3, "description": "Nº de respuestas correctas; debe coincidir con las opciones correcta:true" },
          "dificultad": { "type": "string", "enum": ["facil", "media", "dificil"] },
          "refSeccion": { "type": "string", "description": "Anchor del capítulo de referencia que respalda la pregunta, p.ej. '#cap-4-ts-3'" },
          "fuentes": { "type": "array", "items": { "type": "string" } },
          "etiquetas": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
